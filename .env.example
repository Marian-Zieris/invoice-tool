POSTGRES_USER=changeme
POSTGRES_PASSWORD=changeme
POSTGRES_DB=invoices_db
DATABASE_URL=postgresql://changeme:changeme@db:5432/invoices_db

GROQ_KEY=changeme
GROQ_MODEL=openai/gpt-oss-120b

# Vygenerovat vlastní: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=changeme

# Sdílený klíč pro admin-only endpointy (POST /auth/register, /customers, /customers/{id}/template),
# posílá se v hlavičce X-Admin-Key. Vygenerovat vlastní: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
ADMIN_API_KEY=changeme

GROQ_TIMEOUT_SECONDS=60

# Jen pro produkční nasazení s Caddy reverse proxy (docker-compose.prod.yml) -
# doména musí mít DNS záznam mířící na veřejnou IP droplet-u, jinak Caddy
# nezíská Let's Encrypt certifikát. Lokálně/na OrbStacku se nepoužívá vůbec.
DOMAIN=faktury.example.cz
ACME_EMAIL=admin@example.cz

# Kolik dní držet zálohy databáze (viz scripts/backup_db.sh), starší se mažou
BACKUP_KEEP_DAYS=14
